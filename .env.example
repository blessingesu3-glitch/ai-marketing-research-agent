OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
MODEL_NAME=gpt-4o-mini

# Optional research settings (defaults shown)
# Number of focused searches per question. Each one is a Tavily call.
MAX_SEARCHES=5
TAVILY_MAX_RESULTS=5
# "advanced" gives better results but costs 2 Tavily credits per search instead of 1.
TAVILY_SEARCH_DEPTH=basic
# "true" sends page excerpts to the model: better evidence, more OpenAI tokens.
TAVILY_INCLUDE_RAW_CONTENT=false
RAW_EXCERPT_CHARS=1500
