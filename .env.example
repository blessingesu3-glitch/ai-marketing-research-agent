OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
MODEL_NAME=gpt-4o-mini

# Optional research settings (defaults shown)
# Focused searches per question. Each one is a Tavily call.
MAX_SEARCHES=6
TAVILY_MAX_RESULTS=8
# "advanced" gives better results but costs 2 Tavily credits per search instead of 1.
TAVILY_SEARCH_DEPTH=basic
# Read page text (not just a 1-2 sentence snippet). Main driver of depth; uses more OpenAI tokens.
TAVILY_INCLUDE_RAW_CONTENT=true
RAW_EXCERPT_CHARS=1500
# Best-scoring sources sent to the analyst.
MAX_SOURCES_FOR_ANALYSIS=24
# 1 = when parts of the question are unanswered, run up to 3 more searches and analyse again.
# 0 = never (cheaper).
FOLLOW_UP_ROUNDS=1

# Credit protection for /research and /teardown (0 = off).
# Runs per visitor (IP address) in any rolling hour.
RATE_LIMIT_PER_HOUR=10
# Runs for ALL visitors together in any rolling 24 hours.
DAILY_RUN_LIMIT=200
# Proxies in front of the app (Render: 1). Used to find the visitor's real IP.
PROXY_HOPS=1
